{
    "name": "@flexmonster/vue",
    "version": "3.0.0-preview.4.1",
    "license": "https://www.flexmonster.com/software-license-agreement/",
    "homepage": "https://prerelease.flexmonster.com/",
    "description": "Vue wrapper for Flexmonster Pivot",
    "author": {
        "name": "Flexmonster",
        "email": "help@flexmonster.com"
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "scripts": {
        "start": "vite",
        "dev": "vite",
        "dev:ssr": "npm run dev --prefix dev-nuxt",
        "build": "vite build --mode lib",
        "build:dev": "vite build"
    },
    "repository": "https://github.com/flexmonster/vue",
    "peerDependencies": {
        "@flexmonster/js": "3.0.0-preview.4.1",
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.0",
        "typescript": "^5.0.0",
        "vite": "^6.2.0",
        "vite-plugin-dts": "^4.0.0",
        "vue": "^3.5.0",
        "vue-tsc": "^2.0.0"
    }
}
